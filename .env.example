# Vigilante.AI — exemplo de variáveis de ambiente.
# Copie para `.env` e ajuste para o seu deployment. Todas usam prefixo VIGILANTE_.

# --- Banco e auth ---
VIGILANTE_DATABASE_URL=sqlite:///./vigilante.db
VIGILANTE_JWT_SECRET=troque-isto-em-producao
VIGILANTE_ALLOW_OPEN_REGISTRATION=1

# --- Storage ---
VIGILANTE_BLOB_STORAGE_PATH=./data/alerts
VIGILANTE_RETRAINING_EXPORT_PATH=../ml/data/feedback

# --- Detector ---
VIGILANTE_MODEL_PATH=best.pt
VIGILANTE_CONFIDENCE_THRESHOLD=0.10
VIGILANTE_ALERT_COOLDOWN_SECONDS=10

# --- Notificações WhatsApp (Meta Cloud API) ---
# Fernet key (base64, 32 bytes) usada para criptografar o token Meta de cada tenant.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem esta chave o serviço de notificações fica desabilitado.
VIGILANTE_NOTIFY_ENCRYPTION_KEY=
VIGILANTE_WHATSAPP_API_BASE=https://graph.facebook.com/v22.0
VIGILANTE_WHATSAPP_HTTP_TIMEOUT=10.0
VIGILANTE_WHATSAPP_DISPATCH_WORKERS=4
VIGILANTE_TEAMS_HTTP_TIMEOUT=10.0
VIGILANTE_TEAMS_DISPATCH_WORKERS=4
VIGILANTE_PUBLIC_APP_URL=http://localhost:3000

# --- HUB de Convergência Conversacional (chat + RAG + WhatsApp inbound) ---
# LLM de chat — DeepSeek primário, OpenRouter fallback (preencha ao menos um).
VIGILANTE_DEEPSEEK_API_KEY=
VIGILANTE_OPENROUTER_API_KEY=
VIGILANTE_LLM_MODEL=deepseek-v4-pro
# Embeddings + Whisper (OpenAI). Sem a chave: busca vetorial vira no-op (só FTS).
VIGILANTE_OPENAI_API_KEY=
VIGILANTE_EMBEDDING_MODEL=text-embedding-3-small
# Reranker cross-encoder via Hugging Face Inference API (opcional).
VIGILANTE_HF_TOKEN=
# Semeia knowledge/*.md (manual + NR-6 + NR-18) como docs globais no startup.
VIGILANTE_KB_SEED_ON_STARTUP=1

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
